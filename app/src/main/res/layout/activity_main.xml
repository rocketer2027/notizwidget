<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/btn_menu"
        android:layout_width="56dp"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Menü"
        android:focusable="false"
        android:gravity="center"
        android:text="⋮"
        android:textSize="26sp" />

    <!-- Das Textfeld liegt in einer ScrollView: Dadurch scrollt ein kräftiges Wischen mit Schwung
         bis ganz nach unten, und rechts zeigt ein dezenter Balken die Position. -->
    <ScrollView
        android:id="@+id/editor_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbarSize="6dp"
        android:scrollbarStyle="insideOverlay"
        android:scrollbarThumbVertical="@drawable/widget_scrollbar"
        android:scrollbarTrackVertical="@drawable/widget_scrolltrack"
        android:scrollbars="vertical">

        <EditText
            android:id="@+id/editor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="top|start"
            android:hint="Notiz schreiben …"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp"
            android:textSize="18sp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tb_bold"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:text="B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tb_italic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:text="I"
            android:textSize="20sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/tb_underline"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Unterstreichen"
            android:focusable="false"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="U"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tb_size"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:text="18"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tb_color"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:text="Farbe"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>
