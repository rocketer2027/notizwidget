<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/version_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <!-- ===== Aussehen ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="16dp"
            android:background="#9E9E9E"
            android:padding="12dp">

            <TextView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="14dp"
                android:text="@string/set_preview" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/set_bgcolor"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/swatch_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/label_transp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/seek_transp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="90" />

        <TextView
            android:id="@+id/label_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/seek_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20" />

        <Switch
            android:id="@+id/switch_dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/set_dark"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_language"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingEnd="16dp"
            android:textColor="?android:attr/colorAccent"
            android:textSize="16sp" />

        <!-- ===== Automatische Sicherung ===== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#66888888" />

        <Switch
            android:id="@+id/switch_backup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/set_auto"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/label_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/seek_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="13" />

        <TextView
            android:id="@+id/btn_time"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="16dp"
            android:textColor="?android:attr/colorAccent"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/radio_format"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/fmt_html"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fmt_html"
                android:textColor="?android:attr/textColorPrimary" />

            <RadioButton
                android:id="@+id/fmt_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fmt_txt"
                android:textColor="?android:attr/textColorPrimary" />
        </RadioGroup>

        <Button
            android:id="@+id/btn_backup_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_backup_now" />

        <Button
            android:id="@+id/btn_test_auto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_test_auto" />

        <TextView
            android:id="@+id/label_keep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/seek_keep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="49" />

        <Button
            android:id="@+id/btn_cleanup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_cleanup" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_backup_hint"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <!-- ===== E-Mail ===== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#66888888" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/set_email_label"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edit_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="name@beispiel.de"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress"
            android:textColor="?android:attr/textColorPrimary" />

    </LinearLayout>
</ScrollView>
