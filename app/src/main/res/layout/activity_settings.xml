<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Einstellungen"
            android:textColor="#222222"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/version_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#777777"
            android:textSize="13sp" />

        <!-- ===== Aussehen ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="16dp"
            android:background="#9E9E9E"
            android:padding="12dp">

            <TextView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="14dp"
                android:text="Vorschau\nMilch, Brot, Eier" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Hintergrundfarbe"
            android:textColor="#222222"
            android:textSize="16sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/swatch_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/label_transp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#222222"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/seek_transp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="90" />

        <TextView
            android:id="@+id/label_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#222222"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/seek_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20" />

        <!-- ===== Automatische Sicherung ===== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#DDDDDD" />

        <Switch
            android:id="@+id/switch_backup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Automatische Sicherung"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/label_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#222222"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/seek_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="13" />

        <TextView
            android:id="@+id/btn_time"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="16dp"
            android:textColor="#1565C0"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/radio_format"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/fmt_html"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HTML-Datei (mit Formatierung)"
                android:textColor="#222222" />

            <RadioButton
                android:id="@+id/fmt_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Textdatei (.txt, nur Text)"
                android:textColor="#222222" />
        </RadioGroup>

        <Button
            android:id="@+id/btn_backup_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Jetzt sichern" />

        <Button
            android:id="@+id/btn_test_auto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Automatik testen (in ca. 1 Minute)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Gespeichert wird im Ordner Dokumente/Catatan-Sicherungen auf dem Handy. Für Google Drive: im Menü der Notiz „Sicherung speichern …“ wählen und dort Drive als Ablageort auswählen. Bei jeder automatischen Sicherung zeigt Catatan eine Benachrichtigung. Kommt nichts an: In den Android-Einstellungen unter Apps → Catatan → Akku „Nicht eingeschränkt“ wählen und Benachrichtigungen erlauben."
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- ===== E-Mail ===== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#DDDDDD" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Meine E-Mail-Adresse (für „Per E-Mail senden“)"
            android:textColor="#222222"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edit_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="name@beispiel.de"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress"
            android:textColor="#222222" />

    </LinearLayout>
</ScrollView>
