<?xml version="1.0" encoding="utf-8"?>
<!-- Startfenster: wird vom System nur gezeigt, solange die App noch laedt -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFF6C8" />
        </shape>
    </item>
    <item
        android:width="150dp"
        android:height="150dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/logo_start_blue" />
    </item>
</layer-list>
